{
  "manifest_version": 3,
  "name": "NETRA-Mail Shield",
  "version": "3.4.1",
  "description": "User-requested Gmail email threat analysis powered by NETRA-Mail.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://netra-mail-api.onrender.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "NETRA-Mail Shield"
  }
}

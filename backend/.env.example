NETRA_MAX_EMAIL_SIZE_MB=10
NETRA_GEOIP_ENABLED=true
NETRA_AI_ENABLED=true
NETRA_DATABASE_PATH=forensic_ledger.db
NETRA_MODEL_PATH=data/phishing_model.joblib

# Build with: docker build -f inspection/Dockerfile -t netra-inspector:4.4.0 .
NETRA_INSPECTION_IMAGE=netra-inspector:4.4.0
# Explicit opt-in: contacts public URL destinations from a constrained worker.
NETRA_EXPAND_SHORT_URLS=0
# Explicit opt-in: discloses URLs to external reputation providers.
NETRA_URL_REPUTATION_ENABLED=false
# Inject real provider credentials through the environment, never this file.
NETRA_GOOGLE_SAFE_BROWSING_KEY=
NETRA_URLHAUS_AUTH_KEY=
# Only applied to server-fetched Gmail originals, never uploaded EML.
NETRA_TRUSTED_AUTHSERV_IDS=mx.google.com
# Set explicitly in deployments. scripts/start_local.py detects the unpacked
# Chrome extension whose installed path exactly matches this project.
NETRA_EXTENSION_ID=
